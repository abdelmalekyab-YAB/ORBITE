# Reverse proxy de production. {$DOMAIN} vient de .env.prod ; Caddy obtient et renouvelle le certificat HTTPS.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# API et administration Django
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /admin* {
		reverse_proxy backend:8000
	}
	# Fichiers statiques Django (collectstatic, volume partagé)
	handle_path /static/* {
		root * /srv/static
		file_server
	}

	# SPA React : toute autre route renvoie index.html
	handle {
		root * /srv/app
		try_files {path} /index.html
		file_server
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
	}
}
