# Production. Copier en .env.prod (jamais commité) puis renseigner chaque valeur. Voir docs/08-deploiement.md.
DOMAIN=orbit.exemple.com
ALLOWED_HOSTS=orbit.exemple.com
FRONTEND_URL=https://orbit.exemple.com

DJANGO_DEBUG=0
# Longue chaîne aléatoire : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

POSTGRES_USER=orbit
POSTGRES_PASSWORD=
POSTGRES_DB=orbit
DATABASE_URL=postgres://orbit:MOT_DE_PASSE@db:5432/orbit
REDIS_URL=redis://redis:6379/0

# Envoi des e-mails (invitations, notifications)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Orbit <orbit@exemple.com>

# Pièces jointes sur un stockage S3-compatible (recommandé en production)
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

BACKUP_RETENTION_DAYS=14
LOG_LEVEL=INFO
# Optionnel : supervision des erreurs
SENTRY_DSN=

# --- Facturation : Zoho Books en LECTURE SEULE (optionnel) ---
# Self Client sur https://api-console.zoho.com, scopes *.READ uniquement.
ZOHO_ORGANIZATION_ID=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
