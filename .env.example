# Développement local (docker compose). Copier en .env : cp .env.example .env
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-only-change-me
DATABASE_URL=postgres://orbit:orbit@db:5432/orbit
REDIS_URL=redis://redis:6379/0
FRONTEND_URL=http://localhost:5173
# E-mails capturés par MailHog (http://localhost:8025)
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL=Orbit <orbit@digitalia-ltd.com>
LOG_LEVEL=INFO
